{
  "id": "rushes.panel",
  "name": "Rushes",
  "version": "0.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "manifestVersion": 5,
  "requiredPermissions": { "network": { "domains": "all" } },
  "entrypoints": [ {
    "type": "panel", "id": "rushes",
    "minimumSize": { "width": 260, "height": 300 }, "maximumSize": { "width": 2000, "height": 4000 },
    "preferredDockedSize": { "width": 340, "height": 600 }, "preferredFloatingSize": { "width": 420, "height": 640 },
    "label": { "default": "Rushes" },
    "icons": [ { "width": 23, "height": 23, "path": "icons/p.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"] } ]
  } ],
  "icons": [ { "width": 48, "height": 48, "path": "icons/i.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"], "species": ["pluginList"] } ]
}
