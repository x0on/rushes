{
  "id": "rushes.panel",
  "name": "Rushes",
  "version": "0.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "webview": {
      "allow": "yes",
      "domains": "all",
      "enableMessageBridge": "localAndRemote"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "rushes",
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 6000,
        "height": 6000
      },
      "preferredDockedSize": {
        "width": 520,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 1000,
        "height": 760
      },
      "label": {
        "default": "Rushes"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/p.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/i.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
